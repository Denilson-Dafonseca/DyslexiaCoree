{
    "builds": [
        {
            "src": "Dyslexia/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.12"
            }
        },
        {
            "src": "static/**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/(.*)",
            "dest": "Dyslexia/wsgi.py"
        }
    ],
    "env": {
        "DATABASE_URL": "@database_url",
        "SECRET_KEY": "@secret_key",
        "DEBUG": "False",
        "VERCEL": "True"
    }
}